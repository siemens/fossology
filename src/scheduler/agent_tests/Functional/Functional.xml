<testsuites timeout="600">

  <!--
  @brief Every test suite needs its own copy of the scheduler
  
  The startup will start a scheduler using the configuration and log file
  specified by the test suite. It will then wait 1 second.
  
  The cleanup will use the cli to send a stop command to the scheduler. This
  will cause the scheduler to close if it is still running.
   -->
  <setup>
    <concurrently command="{scheduler}" params="--config={config} --log={log} --verbose=952"/>
    <loadConf directory="{config}"/>
    <sleep duration="1"/>
  </setup>
  <cleanup>
    <sequential command="{scheduler}" params="--config={config} -k"/>
  </cleanup>
  
  <!--
  @brief Tests that the scheduler's stop command is working correctly
  
  This starts a scheduler and waits for it to stop running the startup tests,
  it then sends a stop command. Since the scheduler doesn't have any currently
  running agents, this will cause the scheduler to stop running immediately.
  -->
  <testsuite name="JustStop" longest="57">
    <definitions pwd       = "{$pwd}"
                 config    = "{pwd}/src/scheduler/agent_tests/gen/agents"
                 log       = "{config}/fossology.log"
                 agentdir  = "{pwd}/src/scheduler/agent"
                 scheduler = "{agentdir}/fo_scheduler"
                 cli       = "{agentdir}/fo_cli"/>
    <setup>
      <sequential command="{cli}" params="--config={config} -S" retval="0"
                  result="scheduler:{pids:0} revision:{BUILD:COMMIT_HASH} daemon:0 jobs:0 log:{log} port:{FOSSOLOGY:port} verbose:952"/>
    </setup>
  
    <!-- Stop the scheduler and make sure it isn't running anymore -->
    <test name="scheduler stop">
      <sequential command="{cli}" params="--config={config} -s" retval="0"/>
      <sleep duration="5"/>
      <sequential command="{cli}" params="--config={config} -S" retval="255"/>
    </test>
  </testsuite>

  <!--
  @brief Tests that the test agents are handled correctly
  
  This sets the scheduler to start on the agents found in the agent_tests/agents
  directory. These should test all of the possible fail cases and several of the
  success cases for the agents.
  
  @note  If a type of failing agent that is not currently tests is found, it
         should be added as a .c file under the agent_tests/agents directory
  -->
  <testsuite name="TestAgents" longest="53">
    <definitions pwd       = "{$pwd}"
                 config    = "{pwd}/src/scheduler/agent_tests/gen/agents"
                 log       = "{config}/fossology.log"
                 agentdir  = "{pwd}/src/scheduler/agent"
                 scheduler = "{agentdir}/fo_scheduler"
                 cli       = "{agentdir}/fo_cli"/>
    <setup>
      <sequential command="{cli}" params="--config={config} -S" retval="0"
                  result="scheduler:{pids:0} revision:{BUILD:COMMIT_HASH} daemon:0 jobs:0 log:{log} port:{FOSSOLOGY:port} verbose:952"/>
    </setup>
    
    <!-- Test that the correct agents passed the startup test -->
    <test name = "agents">
      <sequential command="{cli}" params="--config={config} -a" retval="0"
                  result="db_connect multi_connect no_update simple"/>
    </test>
    
    <!-- Test that the scheduler has the correct status -->
    <test name = "status">
      <sequential command="{cli}" params="--config={config} -S" retval="0"
                  result="scheduler:{pids:0} revision:{BUILD:COMMIT_HASH} daemon:0 jobs:0 log:{log} port:{FOSSOLOGY:port} verbose:952"/>
    </test>
    
    <!-- Test that the host load is correct for no running agents -->
    <test name = "load">
      <sequential command="{cli}" params="--config={config} -l" retval="0"
                  result="host:localhost address:localhost max:10 running:0"/>
    </test>
  </testsuite>
  
  <!--
  @brief Tests the graceful and non-graceful scheduler shutdowns
  
  Start a scheduler with the test agents but do not wait for it to stop running
  the startup tests. Send the scheduler a stop command and make sure that it is
  still running. Then send the scheduler a die command and make sure that it is
  not running.
  -->
  <testsuite name="Stop/Die" longest="12">
    <definitions pwd       = "{$pwd}"
                 config    = "{pwd}/src/scheduler/agent_tests/gen/agents"
                 log       = "{config}/fossology.log"
                 agentdir  = "{pwd}/src/scheduler/agent"
                 scheduler = "{agentdir}/fo_scheduler"
                 cli       = "{agentdir}/fo_cli"/>
    
    <!-- Send a stop command to the scheduler, it should keep running -->
    <test name="scheduler stop">
      <sequential command="{cli}" params="--config={config} -s" retval="0"/>
      <sleep duration="5"/>
      <sequential command="{cli}" params="--config={config} -S" retval="0"/>
    </test>

    <!-- Send a die command to the scheduler, it should stop running -->
    <test name="scheduler die">
      <sequential command="{cli}" params="--config={config} -D" retval="0"/>
      <sleep duration="5"/>
      <sequential command="{cli}" params="--config={config} -S" retval="255"/>
    </test>
  </testsuite>
  
  <!--
  @brief Tests the scheduler with the standard agents
  
  This will basically mimics the "TestAgents" test but uses the actual agents
  instead of the test agents. This will start the scheduler and wait for startup
  tests to finish. Unlike with the test agents, all the agents should pass this
  step.
  -->
  <testsuite name="RealAgents" longest="3">
    <definitions pwd       = "{$pwd}"
                 config    = "{pwd}/src/scheduler/agent_tests/gen/agents"
                 log       = "{config}/fossology.log"
                 agentdir  = "{pwd}/src/scheduler/agent"
                 scheduler = "{agentdir}/fo_scheduler"
                 cli       = "{agentdir}/fo_cli"/>
    <setup>
      <sequential command="{cli}" params="--config={config} -S" retval="0"
                  result="scheduler:{pids:0} revision:{BUILD:COMMIT_HASH} daemon:0 jobs:0 log:{log} port:{FOSSOLOGY:port} verbose:952"/>
    </setup>
    
    <!-- Test that the correct agents passed the startup test -->
    <test name = "agents">
      <sequential command="{cli}" params="--config={config} -a" retval="0"
                  result="adj2nest buckets copyright decider deciderjob delagent ecc maintagent mimetype monk monkbulk ninka nomos pkgagent readmeoss reuser spdx2 ununpack wget_agent"/>
    </test>
    
    <!-- Test that the scheduler has the correct status -->
    <test name = "status">
      <sequential command="{cli}" params="--config={config} -S" retval="0"
                  result="scheduler:{pids:0} revision:{BUILD:COMMIT_HASH} daemon:0 jobs:0 log:{log} port:{FOSSOLOGY:port} verbose:952"/>
    </test>
    
    <!-- Test that the host load is correct for no running agents -->
    <test name = "load">
      <sequential command="{cli}" params="--config={config} -l" retval="0"
                  result="host:localhost address:localhost max:10 running:0"/>
    </test>
  </testsuite>
  
  <!--
  @brief Starts a scheduler with the real agents and stops it 
  
  This simply starts up a scheduler and stops it using the cli stop command.
  -->
  <testsuite name="StopRealAgents" longest="7">
    <definitions pwd       = "{$pwd}"
                 config    = "{pwd}/src/scheduler/agent_tests/gen/agents"
                 log       = "{config}/fossology.log"
                 agentdir  = "{pwd}/src/scheduler/agent"
                 scheduler = "{agentdir}/fo_scheduler"
                 cli       = "{agentdir}/fo_cli"/>
    <setup>
      <sequential command="{cli}" params="--config={config} -S" retval="0"
                  result="scheduler:{pids:0} revision:{BUILD:COMMIT_HASH} daemon:0 jobs:0 log:{log} port:{FOSSOLOGY:port} verbose:952"/>
    </setup>
  
    <test name="Real Stop">
      <sequential command="{cli}" params="--config={config} -s" retval="0"/>
      <sleep duration="5"/>
      <sequential command="{cli}" params="--config={config} -S" retval="255"/>
    </test>
  
  </testsuite>
  
  <!-- 
  @brief Uploads a file to the test database and runs all the agents on it
  
  This will upload a file to the test database and schedule all the agents to
  run on that file. After the scheduler finishes running, this checks that all
  the jobs finsihed correctly.
  -->
  <testsuite name="SimpleUpload" longest="600">
    <definitions pwd       = "{$pwd}"
                 config    = "{pwd}/src/scheduler/agent_tests/gen/agents"
                 log       = "{config}/fossology.log"
                 agentdir  = "{pwd}/src/scheduler/agent"
                 scheduler = "{agentdir}/fo_scheduler"
                 cp2foss   = "{pwd}/src/cli/cp2foss"
                 fossjobs  = "{pwd}/src/cli/fossjobs"
                 cli       = "{agentdir}/fo_cli"
                 user      = "fossy"
                 pass      = "fossy"
                 dbuser    = "fossologytest"/>
    <setup>
      <upload file="{pwd}/../src/testing/dataFiles/TestData/archives/3files.tar.bz2"/>
      <schedule upload="{upload_pk:0}"/>
      <sequential command="{cli}" params="--config={config} -S" retval="0"
                  result="scheduler:{pids:0} revision:{BUILD:COMMIT_HASH} daemon:0 jobs:0 log:{log} port:{FOSSOLOGY:port} verbose:952"/>
    </setup>
     
    <test name = "finished">
      <database sql="select jq_end_bits from jobqueue left join job on jq_job_fk = job_pk where job_upload_fk = {upload_pk:0};">
        <loop varname="i" iterations="7">
          <dbequal row="{i}" col="0" val="1"/>
        </loop>
      </database>
    </test>
  </testsuite>
  
  <!--
  @brief Runs the scheduler on serveral uploads
  
  Upload and scheduler agents on several
  -->
  <testsuite name="UploadSeveral" longest="600">
    <definitions pwd       = "{$pwd}"
                 config    = "{pwd}/src/scheduler/agent_tests/gen/agents"
                 log       = "{config}/fossology.log"
                 agentdir  = "{pwd}/src/scheduler/agent"
                 scheduler = "{agentdir}/fo_scheduler"
                 cp2foss   = "{pwd}/src/cli/cp2foss"
                 fossjobs  = "{pwd}/src/cli/fossjobs"
                 cli       = "{agentdir}/fo_cli"
                 user      = "fossy"
                 pass      = "fossy"
                 dbuser    = "fossologytest"
                 filelist  = "3files.tar.bz2,
                              foss23D1F1L.tar.bz2,
                              fossI16L335U29.tar.bz2,
                              verifyFossI16L335U29.tar.bz2,
                              eddyData.tar.bz2,
                              fossDirsOnly.tar.bz2,
                              fossI16L518.7z"/>
    <setup>
      <loop varname="filename" values="{filelist}">
        <upload file="{pwd}/../src/testing/dataFiles/TestData/archives/{filename}"/>
      </loop>
      <loop varname="i" iterations="7">
        <schedule upload="{upload_pk:{i}}"/>
      </loop>
      <sequential command="{cli}" params="--config={config} -S" retval="0"
                  result="scheduler:{pids:0} revision:{BUILD:COMMIT_HASH} daemon:0 jobs:0 log:{log} port:{FOSSOLOGY:port} verbose:952"/>
    </setup>
    
    <test name = "check completion">
      <loop varname="uploadnum" values="0,1,2,3,4,5,6">
        <database sql="select jq_end_bits from jobqueue left join job on jq_job_fk = job_pk where job_upload_fk = {upload_pk:{uploadnum}};">
          <loop varname="i" iterations="7">
            <dbequal row="{i}" col="0" val="1"/>
          </loop>
        </database>
      </loop>
    </test>
    
  </testsuite>

  <!--
  @brief Tests the per-agent-type version refresh.

  Regression guard for the change that made a code/version change refresh only
  the affected agent type instead of restarting every agent (which used to
  discard unchanged agents' in-flight work / pfile reuse).

  The test bumps ONE test agent's reported VERSION on disk, sends a real SIGHUP
  to the running scheduler, and then asserts, from the scheduler log and the CLI
  socket, that:
    - the changed type ("simple") was detected as changed and refreshed,
    - the unchanged types were NOT touched,
    - a change to the scheduler's own build hash (COMMIT_HASH) no longer triggers
      the old build-wide "kill every agent" path,
    - all agents remain valid and the scheduler stays up throughout.

  Backups are taken to /tmp and restored on cleanup so the shared gen/agents
  tree is left pristine for other suites.
  -->
  <testsuite name="VersionRefresh" longest="45">
    <definitions pwd       = "{$pwd}"
                 config    = "{pwd}/src/scheduler/agent_tests/gen/agents"
                 log       = "{config}/fossology.log"
                 agentdir  = "{pwd}/src/scheduler/agent"
                 scheduler = "{agentdir}/fo_scheduler"
                 cli       = "{agentdir}/fo_cli"
                 simplever = "{config}/mods-enabled/simple/VERSION"
                 topver    = "{config}/VERSION"
                 baksimple = "/tmp/fo_simple_VERSION.bak"
                 baktop    = "/tmp/fo_top_VERSION.bak"/>
    <setup>
      <!-- confirm the scheduler is up and the startup tests have drained (jobs:0) -->
      <sequential command="{cli}" params="--config={config} -S" retval="0"
                  result="scheduler:{pids:0} revision:{BUILD:COMMIT_HASH} daemon:0 jobs:0 log:{log} port:{FOSSOLOGY:port} verbose:952"/>
      <!-- back up the two files this suite rewrites; setup always refreshes the
           backup before modifying, so a stale copy cannot survive a rerun -->
      <sequential command="cp" params="{simplever} {baksimple}" retval="0"/>
      <sequential command="cp" params="{topver} {baktop}" retval="0"/>
    </setup>

    <!--
    Change one agent's version and SIGHUP: only that type must be refreshed.
    -->
    <test name="refresh only the changed agent type">
      <!-- bump ONLY the "simple" agent's reported version on disk -->
      <sequential command="sed"
                  params="-i 's/^VERSION=.*/VERSION=changed-v2/' {simplever}" retval="0"/>

      <!-- send a REAL SIGHUP to the running scheduler process -->
      <sequential command="kill" params="-HUP {pids:0}" retval="0"/>

      <!-- poll (no fixed sleep) until the changed type is detected and refreshed -->
      <waitfor command="grep"
               params="-F 'META_AGENT[simple] code changed' {log}"
               retval="0" timeout="30"/>

      <!-- the unchanged types must NOT have been refreshed -->
      <sequential command="grep"
                  params="-F 'META_AGENT[db_connect] code changed' {log}" retval="1"/>
      <sequential command="grep"
                  params="-F 'META_AGENT[multi_connect] code changed' {log}" retval="1"/>
      <sequential command="grep"
                  params="-F 'META_AGENT[no_update] code changed' {log}" retval="1"/>

      <!-- every agent must still be valid and the scheduler still answering -->
      <sequential command="{cli}" params="--config={config} -a" retval="0"
                  result="db_connect multi_connect no_update simple"/>
    </test>

    <!--
    Changing the scheduler's own build hash must NOT restart every agent.
    -->
    <test name="build hash change does not kill all agents">
      <!-- change the scheduler build hash (top-level VERSION file) -->
      <sequential command="sed"
                  params="-i 's/^COMMIT_HASH.*/COMMIT_HASH=deadbeef-func/' {topver}" retval="0"/>

      <sequential command="kill" params="-HUP {pids:0}" retval="0"/>

      <!-- poll until the new, benign per-type note appears -->
      <waitfor command="grep"
               params="-F 'scheduler build changed' {log}"
               retval="0" timeout="30"/>

      <!-- the scheduler process must still be alive and answering (a pure
           build-hash change must not tear it down). The strong "agents were not
           killed" check is the -a assertion below: all four agents still valid. -->
      <sequential command="{cli}" params="--config={config} -S" retval="0"/>

      <!-- scheduler still up, all agents still valid -->
      <sequential command="{cli}" params="--config={config} -a" retval="0"
                  result="db_connect multi_connect no_update simple"/>
    </test>

    <cleanup>
      <!-- restore the files we rewrote (runs after the scheduler is stopped) -->
      <sequential command="cp" params="{baksimple} {simplever}"/>
      <sequential command="cp" params="{baktop} {topver}"/>
      <sequential command="rm" params="-f {baksimple} {baktop}"/>
    </cleanup>
  </testsuite>

  <!--
  @brief Negative path: a broken agent must fail its re-probe in isolation.

  Corrupts ONE agent's VERSION file so its library can no longer parse it. On the
  next SIGHUP re-probe that agent exits before presenting a "VERSION:" line, so
  the scheduler invalidates it. This test asserts the failure is isolated: only
  the broken agent is invalidated, every other agent stays valid, and the
  scheduler stays up (it is not taken down by the failure).
  -->
  <testsuite name="VersionRefreshNegative" longest="40">
    <definitions pwd       = "{$pwd}"
                 config    = "{pwd}/src/scheduler/agent_tests/gen/agents"
                 log       = "{config}/fossology.log"
                 agentdir  = "{pwd}/src/scheduler/agent"
                 scheduler = "{agentdir}/fo_scheduler"
                 cli       = "{agentdir}/fo_cli"
                 simplever = "{config}/mods-enabled/simple/VERSION"
                 bakneg    = "/tmp/fo_simple_VERSION.neg.bak"/>
    <setup>
      <sequential command="{cli}" params="--config={config} -S" retval="0"
                  result="scheduler:{pids:0} revision:{BUILD:COMMIT_HASH} daemon:0 jobs:0 log:{log} port:{FOSSOLOGY:port} verbose:952"/>
      <!-- confirm the agent is valid to begin with -->
      <sequential command="{cli}" params="--config={config} -a" retval="0"
                  result="db_connect multi_connect no_update simple"/>
      <sequential command="cp" params="{simplever} {bakneg}" retval="0"/>
    </setup>

    <test name="broken agent is invalidated without affecting others">
      <!-- corrupt only "simple"'s VERSION file so its library cannot parse it -->
      <sequential command="sed" params="-i 's/.*/!!!BROKEN!!!/' {simplever}" retval="0"/>

      <!-- real SIGHUP triggers the re-probe -->
      <sequential command="kill" params="-HUP {pids:0}" retval="0"/>

      <!-- poll until the broken agent is invalidated ... -->
      <waitfor command="grep"
               params="-F 'simple has been invalidated' {log}"
               retval="0" timeout="30"/>

      <!-- ... only "simple" is gone; the other agents remain valid ... -->
      <sequential command="{cli}" params="--config={config} -a" retval="0"
                  result="db_connect multi_connect no_update"/>

      <!-- ... and the scheduler is still alive and answering. -->
      <sequential command="{cli}" params="--config={config} -S" retval="0"/>
    </test>

    <cleanup>
      <sequential command="cp" params="{bakneg} {simplever}"/>
      <sequential command="rm" params="-f {bakneg}"/>
    </cleanup>
  </testsuite>

</testsuites>





